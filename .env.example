# Server
API_PORT=8787
SESSION_SECRET=replace-with-a-long-random-secret
PUBLIC_APP_URL=http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173

# Email is optional locally. Without these values, messages are written to data/email-outbox.
EMAIL_PROVIDER=smtp
EMAIL_FROM=RecoverAI <no-reply@example.test>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Optional client configuration
VITE_APP_NAME=RecoverAI
VITE_SYNTHETIC_DATA_ONLY=true
